# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Database (SQLite) ────────────────────────────────────
# Prisma resolves this relative to prisma/schema.prisma → backend/prisma/data/hexa.db
# (that folder is the Docker volume mount point). Switch provider in schema.prisma for Postgres.
DATABASE_URL="file:./data/hexa.db"

# ── Auth ─────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── CORS (frontend origins, comma-separated) ─────────────
CORS_ORIGIN=http://localhost:5180

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000
MAX_UPLOAD_BYTES=2097152

# ── Seed admin (used once by `npm run seed`) ─────────────
ADMIN_EMAIL=admin@hexa.ai
ADMIN_PASSWORD=ChangeMe!123
ADMIN_NAME=Hexa Admin

# ── SMTP (optional — leave blank to skip sending contact emails) ──
# Điền thông tin email server của anh vào đây.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hexa AI <no-reply@hexa.ai>"
CONTACT_TO=info.hexa@hexa.ai
