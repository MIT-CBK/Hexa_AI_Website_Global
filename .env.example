# Environment variables for docker-compose. Copy to `.env` in the repo root and fill in real values.

# REQUIRED — JWT signing key. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public web port (nginx serves the frontend)
WEB_PORT=8080

# Allowed origin for API calls (usually = frontend URL)
CORS_ORIGIN=http://localhost:8080

# Initial admin account (set a strong password before deploying)
ADMIN_EMAIL=admin@hexa.ai
ADMIN_PASSWORD=ChangeMe!123
ADMIN_NAME=Hexa Admin

# SMTP — email server for contact-form notifications. Leave blank to skip sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hexa AI <no-reply@hexa.ai>"
CONTACT_TO=info@hexacyber.ai
